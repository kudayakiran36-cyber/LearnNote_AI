# LearnNote AI - Backend Environment Variables

# Database Configuration
# For local development, SQLite is used by default if DATABASE_URL is not set or begins with sqlite
# For Supabase / Render production: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./learnnote.db

# Groq API Configuration
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=learnnote_ai_jwt_secret_change_me_in_production_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS / Frontend URL (comma-separated if multiple, e.g. http://localhost:5173,https://learnnote.onrender.com)
FRONTEND_URL=http://localhost:5173

# Optional: Supabase Storage Configuration (for cloud file uploads)
# In local development without Supabase, files are securely handled in local backend/storage directory
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=learnnote-files
